{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2b3b5b4fb849488cb4083719350b1232",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RaymarchCloud (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -449.5999755859375,
            "y": -335.1999816894531,
            "width": 270.39996337890627,
            "height": 261.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "dbb3766f4a0f4e98a5c42f3b317ac8f8"
        },
        {
            "m_Id": "4b7469206f194c3a999e97af550a4ff7"
        },
        {
            "m_Id": "e4eb8721484748faafb03423754ec08e"
        },
        {
            "m_Id": "dff25545d3804446b88d543302baca02"
        },
        {
            "m_Id": "7a025f2d8e6f4e97b23f0bc594cbf4e8"
        },
        {
            "m_Id": "2c9fb130dbfd4f7ba88384f73573ce1e"
        },
        {
            "m_Id": "927812f2e17d4b15bf51acdd331a0da2"
        },
        {
            "m_Id": "222e5ec6f9744eaa80741a0bd9aba945"
        },
        {
            "m_Id": "d2c8ed8493fb468091c5211b67339867"
        },
        {
            "m_Id": "3ad2ecfc820840888a1bd9ac83431c1b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RaymarchCloud",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// camPosWorld tas nu emot som ett argument från grafen, vilket garanterar korrekt stereoposition för VR.\r\nfloat3 rayOrigin = mul(GetWorldToObjectMatrix(), float4(camPosWorld, 1.0)).xyz;\r\nfloat3 posObject = mul(GetWorldToObjectMatrix(), float4(posWorld, 1.0)).xyz;\r\nfloat3 rayDir = normalize(posObject - rayOrigin);\r\n\r\nfloat3 safeRayDir = rayDir + 0.000001; \r\nfloat3 invDir = 1.0 / safeRayDir;\r\n\r\nfloat3 t0 = (-0.5 - rayOrigin) * invDir;\r\nfloat3 t1 = (0.5 - rayOrigin) * invDir;\r\n\r\nfloat3 tmin = min(t0, t1);\r\nfloat3 tmax = max(t0, t1);\r\n\r\nfloat tNear = max(max(tmin.x, tmin.y), tmin.z);\r\nfloat tFar = min(min(tmax.x, tmax.y), tmax.z);\r\n\r\nfloat currentAlpha = 0;\r\nfloat maxSteps = 64;\r\ncloudAlpha = 0;\r\ncloudColor = float3(0, 0, 0);\r\n\r\nif (tNear <= tFar) \r\n{\r\n    float distanceTraveled = max(0.0, tNear + 0.001);\r\n    float totalDensity = 0;\r\n    float accumulatedLighting = 0;\r\n\r\n    [loop]\r\n    for (int i = 0; i < maxSteps; i++)\r\n    {\r\n        if (distanceTraveled > tFar) \r\n        {\r\n            break;\r\n        }\r\n        \r\n        float3 currentPos = rayOrigin + (rayDir * distanceTraveled);\r\n        float3 uvw = currentPos + 0.5;\r\n        \r\n        if (uvw.x < -0.001 || uvw.x > 1.001 || uvw.y < -0.001 || uvw.y > 1.001 || uvw.z < -0.001 || uvw.z > 1.001)\r\n        {\r\n            break;\r\n        }\r\n        \r\n        // --- BOX FADE ---\r\n        float3 distToEdge = min(uvw, 1.0 - uvw);\r\n        float minEdgeDist = min(min(distToEdge.x, distToEdge.y), distToEdge.z);\r\n        float boxFade = smoothstep(0.0, 0.05, minEdgeDist);\r\n        \r\n        float sdfDistance = SAMPLE_TEXTURE3D_LOD(_SDF_Volume, sampler_LinearClamp, uvw, 0).r;\r\n        \r\n        float timeVal = _Time.y * 0.15;\r\n        float3 noiseCoord = currentPos * 8.0 + float3(timeVal, timeVal * 0.5, timeVal);\r\n        float proceduralNoise = (sin(noiseCoord.x) * cos(noiseCoord.y) * sin(noiseCoord.z)) * 0.04;\r\n        float fluffySdf = sdfDistance + proceduralNoise;\r\n\r\n        if (fluffySdf < 0.03)\r\n        {\r\n            float densityStep = 0.4;\r\n            \r\n            float3 lightSamplePos = uvw + (lightDir * 0.05);\r\n            float lightSdf = SAMPLE_TEXTURE3D_LOD(_SDF_Volume, sampler_LinearClamp, lightSamplePos, 0).r;\r\n            \r\n            float shadowFactor = saturate(lightSdf * 3.0); \r\n            \r\n            float currentStepDensity = (densityStep * (shadowFactor + 0.2)) * boxFade;\r\n            totalDensity += currentStepDensity;\r\n            \r\n            float stepLight = (shadowFactor * densityStep) * boxFade;\r\n            accumulatedLighting += stepLight;\r\n            \r\n            distanceTraveled += 0.015;\r\n            \r\n            if (totalDensity >= 1.0) break;\r\n        }\r\n        else\r\n        {\r\n            distanceTraveled += max(fluffySdf * 0.25, 0.01);\r\n        }\r\n    }\r\n\r\n    cloudAlpha = saturate(pow(totalDensity, 0.7));\r\n\r\n    float3 ambientShadowColor = CustomShadowColor;\r\n    float3 sunLitColor = CustomSunColor * 1.2;                 \r\n\r\n    float lightingFactor = saturate(accumulatedLighting / (totalDensity + 0.001));\r\n\r\nfloat3 baseCloudColor = lerp(ambientShadowColor, sunLitColor, lightingFactor); \r\n\r\n    cloudColor = baseCloudColor * max(0.0, whitenessMultiplier); \r\n}\r\n\r\n"
}

